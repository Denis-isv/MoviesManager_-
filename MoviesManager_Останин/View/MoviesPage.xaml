<Page x:Class="MoviesManager_Останин.View.MoviesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Фильмы">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Content="Добавить фильм" Width="150" Height="30"
                HorizontalAlignment="Left" Margin="0,0,0,10"
                Command="{Binding OnAddMovie}"/>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Movies}"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Год" Binding="{Binding Year}" Width="Auto"/>
                <DataGridTextColumn Header="Жанры" Binding="{Binding GenresDisplay}" Width="200"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="2*"/>
                <DataGridTemplateColumn Header="Действия" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Редактировать" Margin="2"
                                        Command="{Binding DataContext.OnEditMovie, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="Удалить" Margin="2"
                                        Command="{Binding DataContext.OnDeleteMovie, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>