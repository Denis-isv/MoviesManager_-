<Window x:Class="MoviesManager_Останин.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MoviesManager" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="10">
            <Button Content="Фильмы" Width="120" Height="30" Margin="0,0,10,0"
                    Command="{Binding OnShowMovies}"/>
            <Button Content="Жанры" Width="120" Height="30"
                    Command="{Binding OnShowGenres}"/>
        </StackPanel>

        <Frame x:Name="frame" Grid.Row="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>